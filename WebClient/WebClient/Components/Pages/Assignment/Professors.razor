@page "/Assignment/Professors"
@using Common
@using Common.Utilities
@using global::Shared.DTOs
@using global::Shared.DTOs.Engine
@using WebClient.Components.Shared.DynamicForm
@using WebClient.Components.Shared.DynamicModal
@using WebClient.Components.Shared.Loadings
@using WebClient.Services.Common
@using ScheduleResult = global::Shared.DTOs.Engine.ScheduleResult
@rendermode InteractiveServer

<DynamicModal ModalTitle="تخصیص" Model="assigneModel" TModel="ScheduleSolveRequest" OnValidSubmit="Assigning"/>
<div class="p-6">
    <button type="button" class="btn btn-primary" @onclick="OpenAssignmentModal">تخصیص</button>
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-bold text-base-content">لیست دروس اساتید - ترم جاری</h1>
        <div class="badge badge-primary badge-outline p-4">@_allAssignments.Count درس ارائه شده</div>
    </div>
    <div class="form-control w-50 mb-3 mt-3">
        <label class="label">
            <span class="label-text font-medium">انتخاب ترم</span>
        </label>
        <BSelect Items="_terms" TValue="long" ValueChanged="@(async value => await GetData(value))"></BSelect>
    </div>

    @if (_isLoading)
    {
        <LoadingList/>
    }
    else if (_selectedTerm == 0)
    {
        <div class="alert alert-warning">لطفا ترم را انتخاب کنید.</div>
        
    }
    else if (!_groupedAssignments.Any())
    {
        <div class="alert alert-info">داده‌ای برای نمایش یافت نشد.</div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var kvp in _groupedAssignments)
            {
                var professorName = kvp.Value.FirstOrDefault()?.ProfessorFullName ?? "استاد نامشخص";

                <div class="card bg-base-100 shadow-xl border border-base-200">
                    <div class="card-body p-5">
                        <h2 class="card-title text-primary border-b pb-2 mb-2">
                            <span class="i-heroicons-user-circle"></span> @professorName
                        </h2>

                        <div class="space-y-3">
                            @foreach (var assignment in kvp.Value)
                            {
                                <div class="bg-base-200 p-3 rounded-lg border-r-4 border-secondary hover:shadow-md transition-shadow">
                                    <div class="font-bold text-base-content">@assignment.CourseName</div>
                                    <div class="font-bold text-base-content">@assignment.DegreeLevelTitle</div>
                                    <div class="font-bold text-base-content">@assignment.FieldTitle</div>
                                    <div class="text-xs opacity-70 mt-1 flex justify-between">
                                        <span>@assignment.TimeSlotDayOfWeek.ToPersian()</span>
                                        <span class="font-mono">
                                            @assignment.TimeSlotStartTime
                                            -
                                            @assignment.TimeSlotEndTime
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<AssignmentResDto> _allAssignments = new();
    private Dictionary<long, List<AssignmentResDto>> _groupedAssignments = new();
    private bool _isLoading = false;
    private ScheduleSolveRequest assigneModel = new();
    private List<SelectDto> _terms = [];
    private long _selectedTerm = 0;

    [Inject] public IBaseService BaseService { get; set; }
    [Inject] public IJSRuntime Js { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        await GetTerms();
    }

    private async Task GetData(long selectedTermId)
    {
        _selectedTerm = selectedTermId;
        _isLoading = true;
        try 
        {
            var result = await BaseService.Get<List<AssignmentResDto>>($"v1/Assignment/Get?termId={_selectedTerm}");
            if (result is not null)
            {
                _allAssignments = result;
                _groupedAssignments = _allAssignments
                    .GroupBy(a => a.ProfessorId)
                    .ToDictionary(g => g.Key, g => g.ToList());
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GetTerms()
    {
        _terms = [];
        var result = await BaseService.Get<List<SelectDto>>("v1/Term/GetSelectList");
        if (result is not null)
            _terms = result;
    }

    private async Task OpenAssignmentModal()
    {
        await Js.InvokeVoidAsync("openDialog", "dataModal");
        
    }

    private async Task Assigning()
    {
        var result = await BaseService.Post<ScheduleSolveRequest, ScheduleResult>("v1/CourseSolver/Generate", assigneModel);
        if (result is not null)
        {
            await Js.InvokeVoidAsync("close", "dataModal");
            await GetData(_selectedTerm);
            
        }
    }
}
