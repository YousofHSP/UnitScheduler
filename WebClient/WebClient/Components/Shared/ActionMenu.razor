@*
    ActionMenu

    این کامپوننت فقط مسئول نمایش منوی عملیات است.

    این کامپوننت نباید مستقیماً داخل مودال یا جدول استفاده شود.

    تنها نمونه مجاز آن داخل ActionMenuHost قرار دارد.

    مختصات نمایش از طریق ActionMenuService ارسال می‌شود
    و منو نسبت به کل صفحه (Viewport) نمایش داده می‌شود.
*@
@if (IsOpen)
{
    <div class="fixed inset-0 z-[9998]" @onclick="Close"></div>

    <div class="fixed   z-[9999]
                animate-in
                fade-in
                zoom-in
                duration-100
                min-w-52
                rounded-xl
                border border-base-300
                bg-base-100
                shadow-2xl"
         style="top:@($"{Top}px");left:@($"{Left}px")">

        <div class="px-3 py-2 text-xs font-semibold text-base-content/60 border-b border-base-300">
            عملیات
        </div>
        @foreach (var item in Items.Where(x => x.Key != "Delete"))
        {
            <button type="button"
                    class="cursor-pointer flex w-full items-center gap-3 px-4 py-3 text-sm hover:bg-base-200"
                    @onclick="() => ItemClicked(item.Key)">
                <span>@GetIcon(item.Key)</span>
                <span>@item.Value</span>
            </button>
        }

        @if (Items.ContainsKey("Delete"))
        {
            var delete = "Delete";
            <div class="my-1 border-t border-base-300"></div>

            <button type="button"
                    class="cursor-pointer flex w-full items-center gap-3 px-4 py-3 text-sm text-error hover:bg-error/10"
                    @onclick="() => ItemClicked(delete)">

                <span>🗑️</span>
                <span>حذف</span>
            </button>
        }
    </div>
}