@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Common.Utilities
@using global::Shared.Attribute
@using global::Shared.DTOs
@* @using WebClient.Components.Shared.Tables *@
@typeparam T

@{
    var row = (Data.Page - 1) * Data.Limit;
}
<div class=" overflow-x-auto overflow-y-auto max-w-full min-w-0 rounded-box border border-base-content/5 bg-base-100 flex-shrink-0">
    <table class="table table-zebra min-w-max">
        <thead>
            <tr>
                @if (Actions.Any())
                {
                    <th>عملیات</th>
                }
                <th>#</th>
                @if (HasCheckbox)
                {
                    <th></th>
                }
                @foreach (var property in _properties)
                {
                    var DisplayText = property.GetCustomAttribute<DisplayAttribute>()?.Name ?? property.Name;
                    var Sortable = Sort != null && property.GetCustomAttribute<SortIgnoreAttribute>() is null;
                    var IsSorted = Sort != null && Sort.By == property.Name;
                    <th @onclick="() => ClickHeader(property.Name, Sortable)"
                        style="cursor:@(Sortable ? "pointer" : "default"); user-select:none;">
                        @DisplayText
                        @if (Sortable)
                        {
                            if (IsSorted)
                            {
                                <span>@(Sort.IsAscending ? "▲" : "▼")</span>
                            }
                            else
                            {
                                <span class="text-muted">⇅</span>
                            }
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody class="h-full">

            @foreach (var item in Data.Data)
            {
                <tr>
                    @if (Actions.Any())
                    {
                        <td class="w-14 text-center">
                            <button class="btn btn-sm btn-ghost"
                                    @onclick="@(async (e) => await OpenMenu(e, item))">
                                ⋮
                            </button>
                        </td>
                    }

                    <td>@(++row)</td>
                    @if (HasCheckbox)
                    {
                        <td>
                            <input type="checkbox"
                                   class="checkbox"
                                   checked="@(IsItemSelected(item))"
                                   name="selectedRow"
                                   @onchange="async () => await SelectOnChange(item)" />
                        </td>
                    }
                    @for (var i = 0; i < _properties.Count; i++)
                    {
                        var property = _properties[i];
                        var rawValue = property.GetValue(item);
                        var isFileDownload = property.GetCustomAttribute<FileDownloadAttribute>() is not null;
                        @if (rawValue is bool b)
                        {
                            <td class="text-center align-middle" title="@(b ? "بله" : "خیر")">
                                @if (b)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="w-5 h-5 text-green-500 inline-block"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="#22c55e"
                                         stroke-width="3.5">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M5 13l4 4L19 7" />
                                    </svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="w-5 h-5 text-error inline-block"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor"
                                         stroke-width="3.5">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M6 6l12 12M18 6L6 18" />
                                    </svg>
                                }
                            </td>
                        }
                        else
                        {
                            string cellValue = rawValue switch
                            {
                                decimal dt => dt.ToString("#,##0.####"),
                                DateTime dt => dt.ToShamsi(),
                                DateTimeOffset dto => dto.ToShamsi(),
                                Enum e => e.ToDisplay(),
                                null => "",
                                "True" => "بله",
                                "False" => "خیر",
                                _ => rawValue.ToString() ?? ""
                            };

                            if (isFileDownload)
                            {
                                <td>
                                    @if (string.IsNullOrEmpty(cellValue))
                                    {
                                        <span>بدون فایل</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary" @onclick="() => HandleDownload(item)">
                                            دانلود فایل
                                        </button>
                                    }
                                </td>
                            }
                            else if (cellValue.Length > 30)
                            {
                                <td class="max-w-xs whitespace-normal break-words" title="@cellValue">
                                    @cellValue.Start()
                                </td>
                            }
                            else
                            {
                                <td class="max-w-xs whitespace-normal break-words">
                                    @cellValue
                                </td>
                            }
                        }
                    }

                </tr>
            }
        </tbody>
    </table>
</div>
@if (Data.Limit < Data.Total)
{
    <Pagination Page="Data.Page" Limit="Data.Limit" Total="Data.Total"
                PageChanged="PageChanged" />
}

@code {
    [Parameter] public IndexResDto<T> Data { get; set; } = new();
    private List<PropertyInfo> _properties = [];
    private List<PropertyInfo> _allProperties = [];
    [Parameter] public List<string> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback<string> SelectedRowId { get; set; }
    [Parameter] public EventCallback<List<string>> SelectedRowIds { get; set; }
    [Parameter] public IndexDto IndexDto { get; set; } = new();

    [Parameter]
    public IndexSortDto? Sort { get; set; }

    [Parameter] public EventCallback<IndexDto> ChangeList { get; set; }
    [Parameter] public Dictionary<string, string> Actions { get; set; } = new() { { "edit", "ویرایش" }, { "delete", "حذف" } };
    [Parameter] public EventCallback<(string action, string id)> OnAction { get; set; }
    [Parameter] public bool IsMultiSelect { get; set; }
    [Parameter] public bool HasCheckbox { get; set; } = true;
    private bool _initialized;
    private string _selectedId = "";

    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    [Parameter] public EventCallback<T> OnDownload { get; set; }

    private async Task HandleDownload(T? item)
    {
        if (OnDownload.HasDelegate)
            await OnDownload.InvokeAsync(item);
    }
    #region MyRegion

    [Inject]
    public ActionMenuService MenuService { get; set; } = default!;

    /// <summary>
    /// باز کردن منوی عملیات برای سطر انتخاب‌شده.
    ///
    /// این متد مستقیماً ActionMenu را ایجاد نمی‌کند،
    /// بلکه از ActionMenuService درخواست نمایش ارسال می‌کند.
    ///
    /// علت:
    /// ActionMenu باید خارج از جدول و خارج از مودال رندر شود
    /// تا مختصات نمایش تحت تأثیر CSS والد قرار نگیرد.
    /// </summary>
    private async Task OpenMenu(MouseEventArgs e, T item)
    {
        SelectedItem = item;
        await MenuService.Show!(e.ClientX, e.ClientY, Actions, ActionSelected);
    }

    public T SelectedItem { get; set; }

    private async Task ActionSelected(string action)
    {
        if (SelectedItem is null)
            return;

        await OnActionCall(action, SelectedItem);
    }

    #endregion

    private async Task ClickHeader(string columnName, bool sortable)
    {
        if (!sortable) return;
        await OnSortChanged.InvokeAsync(columnName);
    }
    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            var type = typeof(T);
            _allProperties = type.GetProperties(BindingFlags.Public | BindingFlags.Instance).ToList();
            _properties = _allProperties
                .Where(p => p.GetCustomAttribute<ListIgnoreAttribute>() == null)
                .ToList();

            IndexDto.Limit = Data.Limit;
            IndexDto.Page = Data.Page;
            _initialized = true;
        }
    }

    private async Task SelectOnChange(T item)
    {
        var idProp = _allProperties.FirstOrDefault(i => i.Name == "Id");
        if (idProp is not null)
        {
            var idValue = idProp.GetValue(item);
            var id = idValue?.ToString() ?? "";
            if (string.IsNullOrWhiteSpace(id))
                return;
            if (IsMultiSelect)
            {
                if (SelectedIds.Contains(id))
                    SelectedIds.Remove(id);
                else
                    SelectedIds.Add(id);
                await SelectedRowIds.InvokeAsync(SelectedIds);
            }
            else
            {
                _selectedId = id == _selectedId ? "" : id;
                await SelectedRowId.InvokeAsync(_selectedId);
            }
        }
    }

    private bool IsItemSelected(T item)
    {
        var idProp = _allProperties.FirstOrDefault(i => i.Name == "Id");
        if (idProp is null)
            return false;
        var idValue = idProp.GetValue(item);
        var id = idValue?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(id))
            return false;
        return _selectedId == id || SelectedIds.Contains(id);
    }

    private async Task OnActionCall(string action, T item)
    {
        var idProp = _allProperties.FirstOrDefault(i => i.Name == "Id");
        if (idProp is not null)
        {
            var idValue = idProp.GetValue(item);
            await OnAction.InvokeAsync((action, idValue?.ToString() ?? ""));
        }
    }

    private async Task PageChanged((int Page, int Limit) valueTuple)
    {
        Console.WriteLine("Table PageChanged");
        IndexDto.Page = valueTuple.Page;
        IndexDto.Limit = valueTuple.Limit;
        await ChangeList.InvokeAsync(IndexDto);
    }

}